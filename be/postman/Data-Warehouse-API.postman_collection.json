              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('All-state response includes policy summaries', function () { const data = pm.response.json().data; pm.expect(data.summary).to.have.property('state_k'); pm.expect(data.summary).to.have.property('global_k'); pm.expect(data.summary).to.have.property('current_k0'); pm.expect(data.segments).to.be.an('array'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Policy for one state",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/dss/delivery-buffer",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "dss",
                "delivery-buffer"
              ],
              "query": [
                {
                  "key": "state",
                  "value": "{{state}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('State response includes three comparisons', function () { const data = pm.response.json().data; pm.expect(data.segment.customer_state).to.eql(pm.collectionVariables.get('state') || 'SP'); pm.expect(data).to.have.property('recommended'); pm.expect(data).to.have.property('global_comparison'); pm.expect(data.curve).to.be.an('array'); });",
                  "pm.test('Curve is ordered and late rate does not increase', function () { const rows = pm.response.json().data.curve; for (let i = 1; i < rows.length; i += 1) { pm.expect(rows[i].k).to.be.above(rows[i - 1].k); pm.expect(rows[i].late_rate_train).to.be.at.most(rows[i - 1].late_rate_train); } });",
                  "pm.test('Recommended training rate meets target unless unattainable', function () { const data = pm.response.json().data; if (data.segment.attainable) pm.expect(data.recommended.late_rate_train).to.be.at.most(0.05); });"
                ]
              }
            }
          ]
        },
